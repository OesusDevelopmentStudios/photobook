[Desktop Entry]
Type=Application
Name=Pictorio
GenericName=Image Viewer
Comment=View images and organise your photo library
Icon=io.github.oesusdevelopmentstudios.pictorio
Exec=pictorio %F
Terminal=false
Categories=Qt;KDE;Graphics;Viewer;Photography;
Keywords=image;photo;picture;viewer;slideshow;gallery;
# Folders (opened at their first image, as Gwenview does), and the image types the app opens.
# tests/packaging/TestDesktopFile.cpp checks each image type.
MimeType=inode/directory;image/jpeg;image/png;image/gif;image/webp;image/bmp;image/tiff;image/avif;image/heif;image/jxl;
